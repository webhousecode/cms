    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@upmetrics/sdk": "^0.8.1",
    "@webhouse/cms": "workspace:*",
    "@webhouse/cms-ai": "workspace:*",
    "@webhouse/cms-mcp-client": "workspace:*",
    "@webhouse/cms-mcp-server": "workspace:*",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
