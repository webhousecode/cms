    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
