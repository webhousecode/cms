{
  "name": "@webhouse/cms-admin",
  "version": "0.2.0",
  "description": "Admin UI for @webhouse/cms",
  "private": false,
  "scripts": {
    "predev": "node scripts/copy-consent-element.mjs && node scripts/copy-upmetrics-sdk.mjs",
    "dev": "next dev --port 3010",
    "dev:https": "next dev --port 3010 --experimental-https --experimental-https-key .certs/localhost-key.pem --experimental-https-cert .certs/localhost.pem --hostname 0.0.0.0",
    "prebuild": "node scripts/copy-consent-element.mjs && node scripts/copy-upmetrics-sdk.mjs",
    "build": "next build",
    "start": "next start --port 3010",
    "start:prod": "next start --port 4010",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:api": "vitest run tests/api/",
    "test:all": "vitest run && playwright test",
    "clean": "rm -rf .next .turbo node_modules/.cache"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@broberg/ai-sdk": "0.66.0",
    "@broberg/chat": ">=0.6.3 <1",
    "@broberg/cms-chat-client": "^0.4.20",
    "@broberg/cms-inline-edit": ">=0.12.0 <1",
    "@broberg/consent-cookie": "0.6.0",
    "@broberg/deploy-core": "0.6.0",
    "@broberg/i18n": "0.3.1",
    "@broberg/mail": "0.16.0",
    "@broberg/mail-core": "0.9.2",
    "@broberg/sso": "0.9.0",
    "@broberg/ui-controls-core": "0.2.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
