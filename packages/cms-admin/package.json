    "react-leaflet": "^5.0.0",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
