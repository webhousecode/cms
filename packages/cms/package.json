{
  "name": "@webhouse/cms",
  "version": "0.4.27",
  "description": "AI-native CMS engine built on Hono, Drizzle ORM, and SQLite",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./enrich": {
      "types": "./dist/enrich/index.d.ts",
      "import": "./dist/enrich/index.js",
      "require": "./dist/enrich/index.cjs"
    },
    "./static/*": "./static/*"
  },
  "files": [
    "dist",
    "static",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webhousecode/cms.git",
    "directory": "packages/cms"
  },
  "homepage": "https://github.com/webhousecode/cms#readme",
  "bugs": {
    "url": "https://github.com/webhousecode/cms/issues"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "ai-native",
    "content-management",
    "hono",
    "drizzle",
    "sqlite",
    "zod",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "marked": "^18.3.0",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
