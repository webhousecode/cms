{
  "name": "@webhouse/cms-cli",
  "version": "0.4.27",
  "description": "CLI for @webhouse/cms — init, dev, build, and AI content tools",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cms": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webhousecode/cms.git",
    "directory": "packages/cms-cli"
  },
  "homepage": "https://github.com/webhousecode/cms#readme",
  "bugs": {
    "url": "https://github.com/webhousecode/cms/issues"
  },
  "keywords": [
    "cms",
    "cli",
    "webhouse",
    "ai-native",
    "static-site-generator",
    "content-management",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@webhouse/cms": "workspace:*",
    "@webhouse/cms-ai": "workspace:*",
    "@webhouse/cms-mcp-client": "workspace:*",
    "chokidar": "^6.0.0",
    "citty": "^0.2.2",
    "jiti": "^2.7.0",
    "node-html-parser": "^9.0.7",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@broberg/lens-engine": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "@broberg/lens-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0"
  }
}
